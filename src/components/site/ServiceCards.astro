---
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export interface Props {
  id: string;
  tagline?: string;
  title: string;
  subtitle?: string;
  items: ReadonlyArray<{ title: string; description: string; icon: string }>;
  columns?: 2 | 3;
  highlight?: boolean;
}

const { id, tagline, title, subtitle, items, columns = 3, highlight = false } = Astro.props;
---

<WidgetWrapper id={id}>
  <Fragment slot="bg">
    {
      highlight && (
        <div class="absolute inset-0 bg-tech-grid [mask-image:linear-gradient(to_bottom,transparent,black_20%,black_80%,transparent)]" />
      )
    }
  </Fragment>
  <Headline tagline={tagline} title={title} subtitle={subtitle} />
  <div class:list={['grid gap-6 sm:grid-cols-2', columns === 2 ? 'lg:grid-cols-2' : 'lg:grid-cols-3']}>
    {
      items.map(({ title: itemTitle, description, icon }) => (
        <div
          class:list={[
            'group relative rounded-2xl border p-6 md:p-8 transition duration-200',
            'border-gray-200 bg-white hover:border-[#27A0E2]/60 hover:shadow-lg',
            'dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-[#27A0E2]/60 dark:hover:shadow-[0_0_32px_-8px_rgb(39_160_226/0.45)]',
          ]}
        >
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-[#27A0E2]/12 text-[#1677B3] dark:text-[#27A0E2] ring-1 ring-[#27A0E2]/30">
            <Icon name={icon} class="w-6 h-6" />
          </div>
          <h3 class="mt-5 text-xl font-heading font-semibold text-heading">{itemTitle}</h3>
          <p class="mt-3 text-muted leading-relaxed">{description}</p>
        </div>
      ))
    }
  </div>
</WidgetWrapper>
