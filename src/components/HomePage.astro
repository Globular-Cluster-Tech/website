---
import Layout from '~/layouts/PageLayout.astro';

import TechHero from '~/components/site/TechHero.astro';
import ServiceCards from '~/components/site/ServiceCards.astro';
import ProcessSteps from '~/components/site/ProcessSteps.astro';
import Contact from '~/components/widgets/Contact.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE } from 'astrowind:config';
import { HTML_LANG, FORMSPREE_ACTION, SUPPORT_EMAIL, ui, type Lang } from '~/i18n';
import logo from '~/assets/images/logo-mark.png';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const metadata = {
  title: t.siteName,
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: t.siteName,
    url: new URL(`/${lang}/`, SITE?.site).toString(),
    inLanguage: HTML_LANG[lang],
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    email: SUPPORT_EMAIL,
    logo: new URL(logo.src, SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <TechHero
    badge={t.hero.badge}
    titleBefore={t.hero.titleBefore}
    titleHighlight={t.hero.titleHighlight}
    titleAfter={t.hero.titleAfter}
    subtitle={t.hero.subtitle}
    primary={{ text: t.hero.primary, href: '#ai' }}
    secondary={{ text: t.hero.secondary, href: '#contact' }}
  />

  <ServiceCards
    id="ai"
    tagline={t.ai.tagline}
    title={t.ai.title}
    subtitle={t.ai.subtitle}
    items={t.ai.items}
    columns={2}
    highlight
  />

  <ServiceCards
    id="services"
    tagline={t.services.tagline}
    title={t.services.title}
    subtitle={t.services.subtitle}
    items={t.services.items}
  />

  <ProcessSteps id="process" tagline={t.process.tagline} title={t.process.title} steps={t.process.steps} />

  <WidgetWrapper id="about" containerClass="max-w-4xl">
    <Headline title={t.about.title} tagline={t.about.tagline} subtitle={t.about.body} />
  </WidgetWrapper>

  <Contact
    id="contact"
    tagline={t.contact.tagline}
    title={t.contact.title}
    subtitle={t.contact.subtitle}
    action={FORMSPREE_ACTION}
    method="post"
    hiddenFields={{ _subject: t.contact.subject }}
    inputs={[
      { type: 'text', name: 'name', label: t.contact.name, autocomplete: 'name', required: true },
      { type: 'email', name: 'email', label: t.contact.email, autocomplete: 'email', required: true },
      { type: 'tel', name: 'phone', label: t.contact.phone, autocomplete: 'tel' },
    ]}
    textarea={{ name: 'message', label: t.contact.message, required: true }}
    button={t.contact.submit}
  />
</Layout>
