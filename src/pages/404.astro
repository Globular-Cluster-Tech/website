---
import Layout from '~/layouts/Layout.astro';
import { ui } from '~/i18n';

const { en, zh } = ui;
---

<Layout metadata={{ title: `404 — ${en.notFound.title}`, robots: { index: false, follow: false } }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h1 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h1>
        <p class="text-2xl font-semibold">{en.notFound.text}</p>
        <p class="mt-2 text-2xl font-semibold" lang="zh-CN">{zh.notFound.text}</p>
        <div class="mt-8 flex justify-center gap-4">
          <a href="/en/" class="btn">{en.notFound.button}</a>
          <a href="/zh/" class="btn" lang="zh-CN">{zh.notFound.button}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
